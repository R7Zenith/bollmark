{
  "git": { "deploymentEnabled": { "kalp-topla-wip": false } },
  "ignoreCommand": "git cat-file -e \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" 2>/dev/null && git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ':(exclude)*.md' || exit 1",
  "crons": [
    { "path": "/api/cron/sepet-hatirlatma", "schedule": "0 8 * * *" },
    { "path": "/api/cron/odeme-mutabakat", "schedule": "30 8 * * *" },
    { "path": "/api/cron/instagram", "schedule": "0 7 * * *" },
    { "path": "/api/cron/kalp-topla", "schedule": "0 * * * *" },
    { "path": "/api/cron/kalp-topla-temizlik", "schedule": "30 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/vega/panelapi//:path*",
      "destination": "/api/vega/panelapi/:path*"
    }
  ]
}

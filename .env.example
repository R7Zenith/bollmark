# Veritabani (yerelde SQLite, canliya alirken PostgreSQL baglanti adresiyle degistirilecek)
DATABASE_URL="file:./dev.db"

# NextAuth (admin panel girisi icin) - rastgele uzun bir metin yazin
NEXTAUTH_SECRET="buraya-rastgele-uzun-bir-metin-yazin"
NEXTAUTH_URL="http://localhost:3000"

# Ilk admin kullanicisi (sadece ilk kurulumda tohumlamak icin kullanilir)
ADMIN_EMAIL="admin@bollmark.com"
ADMIN_PASSWORD="guclu-bir-sifre-belirleyin"

# Magaza onizleme sifresi: site "yapim asamasinda" gorunumundeyken,
# ?preview=BU_SIFRE ile gelen ziyaretciye 30 gunluk cookie birakip gercek
# magazayi gosterir (/admin zaten kendi girisiyle korunuyor, bundan etkilenmez).
# Bos birakilirsa (veya tanimsizsa) bu koruma tamamen devre disi kalir ve
# herkes yapim-asamasinda sayfasini gorur.
PREVIEW_PASSWORD=""

# Ileride eklenecek: iyzico / kargo API anahtarlari
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=

# Resend (e-posta gonderimi: sepet hatirlatma, stok bildirimi)
RESEND_API_KEY=""
MAIL_FROM="Bollmark <onboarding@resend.dev>"

# Vercel Cron'un /api/cron/* rotalarini cagirirken kullandigi gizli anahtar
CRON_SECRET=""

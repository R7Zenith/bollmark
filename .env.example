# Veritabani (yerelde SQLite, canliya alirken PostgreSQL baglanti adresiyle degistirilecek)
DATABASE_URL="file:./dev.db"

# NextAuth (admin panel girisi icin) - rastgele uzun bir metin yazin
NEXTAUTH_SECRET="buraya-rastgele-uzun-bir-metin-yazin"
NEXTAUTH_URL="http://localhost:3000"

# Ilk admin kullanicisi (sadece ilk kurulumda tohumlamak icin kullanilir)
ADMIN_EMAIL="admin@bollmark.com"
ADMIN_PASSWORD="guclu-bir-sifre-belirleyin"

# Magaza onizleme sifresi: site "yapim asamasinda" gorunumundeyken,
# ?preview=BU_SIFRE ile gelen ziyaretciye 30 gunluk cookie birakip gercek
# magazayi gosterir (/admin zaten kendi girisiyle korunuyor, bundan etkilenmez).
# Bos birakilirsa (veya tanimsizsa) bu koruma tamamen devre disi kalir ve
# herkes yapim-asamasinda sayfasini gorur.
PREVIEW_PASSWORD=""

# Ileride eklenecek: iyzico / kargo API anahtarlari
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=

# Resend (e-posta gonderimi: sepet hatirlatma, stok bildirimi)
RESEND_API_KEY=""
MAIL_FROM="Bollmark <onboarding@resend.dev>"

# Yeni siparis bildirimi hangi adrese gitsin (bos ise MAIL_FROM kullanilir)
ADMIN_NOTIFY_EMAIL=""

# Vercel Cron'un /api/cron/* rotalarini cagirirken kullandigi gizli anahtar
CRON_SECRET=""

# Excel ice aktariminda KOD3 (urun tipi kodu) sabit haritada eslesmezse, mevcut
# kategori adlari listesiyle en olasi eslesmeyi onermek icin Anthropic API'ye
# sorulur (bkz. EXCEL_KATEGORI_ESLEME_PLANI.md). Tanimli degilse oneri katmani
# sessizce devre disi kalir, onizleme "eslesmedi" gostermeye devam eder.
ANTHROPIC_API_KEY=""

# Koton'un kendi aramasi (autocomplete) bulamadigi urunler icin son care olarak
# Google Custom Search API kullaniliyor (bkz. src/lib/koton-images.ts). Google
# Cloud Console'da bir API key olusturup Custom Search API'yi etkinlestirin,
# programmablesearchengine.google.com'da koton.com'a kisitlanmis bir arama motoru
# olusturup Search Engine ID'sini (cx) alin. Tanimli degilse bu adim sessizce
# atlanir. Gunluk 100 sorguya kadar ucretsiz.
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""

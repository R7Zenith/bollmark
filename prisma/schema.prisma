// Bollmark e-ticaret veritabani semasi
// Neon (serverless Postgres) kullanir - Cloudflare Pages gibi edge ortamlarinda
// calisabilmesi icin driver adapter (@prisma/adapter-neon) ile baglanilir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Kucuk (2,3 MB) sorgu derleyicisi: varsayilan "fast" wasm 4,6 MB ve her
  // Vercel function'ina giriyor (bkz. DEPLOY_STATUS.md, Functions Storage).
  compilerBuild = "small"
  // Kalp Topla: KalpHeart'taki kismi unique indeks semada tanimli kalsin diye
  // (ayri SQL ile eklenseydi sonraki her db push onu silmek isterdi).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id              String     @id @default(cuid())
  // Ticimax'in SOAP semasi kategori ID'lerini Prisma'nin cuid string'leri
  // yerine int bekliyor (bkz. VEGA_PANELAPI_BULGULARI_VE_PLAN.md - Ticimax
  // taklidi bolumu). Bu alan Vega'ya donulen/Vega'dan gelen "ID"/"PID"
  // degerleri icin kalici, kucuk bir tamsayi kimlik saglar.
  vegaId          Int        @unique @default(autoincrement())
  name            String
  slug            String     @unique
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  sizeGuide       String?
  imageUrl        String?
  description     String?
  metaTitle       String?
  metaDescription String?
  // Google urun taksonomisi kimligi (Merchant feed'deki google_product_category,
  // bkz. lib/google-categories.ts). Bossa ust kategorininki, o da yoksa 166.
  googleCategoryId Int?
  // Varsayilan KDV orani (1 | 10 | 20, KDV dahil fiyattan ic yuzde - bkz. lib/vat.ts).
  // Bossa ust kategorininki, o da yoksa %10. Urundeki vatRate bunu ezer.
  vatRate         Int?
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  products        Product[]
  kodMappings     CategoryKodMapping[]
  createdAt       DateTime   @default(now())
}

// Excel ice aktariminda KOD3 (urun tipi kodu) icin ogrenilmis kategori eslemesi -
// yonetici onizlemede bir AI onerisini onayladiginda ya da elle yeni bir eslesme
// girip ice aktardiginda buraya upsert edilir (bkz. EXCEL_KATEGORI_ESLEME_PLANI.md
// bolum 6). Lookup sirasi: once bu tablo, sonra kod icindeki sabit CATEGORY_MAP,
// sonra AI onerisi - kod deploy etmeden yeni bir KOD3 degeri ogretilebilsin diye.
model CategoryKodMapping {
  id         String   @id @default(cuid())
  kod3       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

// Excel KOD6'daki urun sezonu ("2027 Kış"). Katalogdaki varsayilan siralama
// once rank DESC, sonra createdAt DESC - boylece eski sezon stogu sonradan
// aktarilsa bile yeni sezonun onune gecmez (bkz. SEZON_BAZLI_SIRALAMA_PLANI.md,
// lib/seasons.ts). rank otomatik hesaplanir, admin Sezonlar ekranindan degisir.
model Season {
  id        String    @id @default(cuid())
  name      String    @unique
  rank      Int
  isCurrent Boolean   @default(false)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  // Ticimax SOAP semasi urun/varyant kimliklerini int bekliyor (Category.vegaId
  // ile ayni gerekce - bkz. VEGA_PANELAPI_BULGULARI_VE_PLAN.md).
  vegaId      Int           @unique @default(autoincrement())
  name        String
  slug        String        @unique
  code        String?       // Ürün kodu / stil kodu, örn. "6SAM60012HW" - opsiyonel, tekil olmak zorunda degil
  description String
  // Ozgun aciklama akisi (bkz. SEO_FAZ6_OZGUN_ACIKLAMA_VE_YONLENDIRME_PLANI.md,
  // lib/ai-description.ts): taslak yonetici onaylayana kadar sitede gorunmez.
  descriptionDraft      String?   // onay bekleyen AI taslagi
  originalDescription   String?   // tedarikcinin ilk metni - ilk taslakta bir kez dolar, sitede gosterilmez
  descriptionApprovedAt DateTime? // ozgun aciklamanin onaylandigi zaman
  priceCents  Int
  compareAtCents Int?
  costCents   Int?          // opsiyonel - girilirse raporlarda kar marji hesaplanir
  vatRate     Int?          // opsiyonel KDV orani (1 | 10 | 20) - doluysa kategorininkini ezer (bkz. lib/vat.ts)
  status      String        @default("DRAFT")
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?        @relation(fields: [brandId], references: [id])
  seasonId    String?
  season      Season?       @relation(fields: [seasonId], references: [id])
  material    String?
  origin      String?
  careInstructions String?
  gender      String?
  tags        Tag[]
  isFeatured  Boolean       @default(false)
  kalpToplaExcluded Boolean @default(false) // "Kalp Topla dışı": bar görünmez, kupon uygulanmaz/taşınmaz (KALP_TOPLA_PLANI.md)
  images      ProductImage[]
  variants    ProductVariant[]
  optionImages ProductOptionImage[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  bundles       Bundle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([seasonId])
}

// Slug'i degisen ya da silinen urunun eski adresi -> yeni hedef (301). Urun
// sayfasi yalniz urun bulunamadiginda bu tabloya bakar (bkz. lib/product-redirects.ts).
model ProductRedirect {
  id        String   @id @default(cuid())
  fromSlug  String   @unique   // eski urun slug'i (decode edilmis haliyle)
  toPath    String             // hedef yol, ör. /urunler/yeni-slug veya /erkek/gomlek
  createdAt DateTime @default(now())
}

// Bundle/set indirimi - sepette bir bundle'a dahil TUM urunlerden en az
// 1'er adet varsa (kismi eslesme tetiklemez), bu urunlerin satir toplamina
// discountPercent uygulanir (bkz. lib/bundles.ts).
model Bundle {
  id              String    @id @default(cuid())
  name            String
  discountPercent Int // sepette bundle'a dahil TUM urunler varsa uygulanan indirim
  isActive        Boolean   @default(true)
  products        Product[]
  createdAt       DateTime  @default(now())
  // Anasayfa "Kombini Tamamla" bolumu (bkz. components/home/complete-the-look.tsx).
  imageUrl        String? // kombin fotografi (R2)
  showOnHome      Boolean   @default(false)
  homeSortOrder   Int       @default(0)
  // [{ productId, x, y }] - x/y fotografin yuzdesi (0-100), bkz. lib/bundles.ts parseHotspots
  hotspotsJson    String    @default("[]")
  // Urunlerin anasayfadaki/admin'deki sirasi: [productId, ...] (bkz. lib/bundles.ts parseProductOrder)
  productOrderJson String   @default("[]")
}

// Favoriler - guest kullanicida localStorage'da (bkz. lib/wishlist.tsx),
// giris yapinca buraya senkronize edilir (@@unique tekrar eklemeyi
// engeller, senkronizasyonda skipDuplicates ile sessizce atlanir).
model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Beden, Renk gibi varyant ozellik tipleri (magaza genelinde tanimli)
model VariantAttribute {
  id        String                  @id @default(cuid())
  name      String                  @unique // "Beden", "Renk"
  position  Int                     @default(0)
  isColor   Boolean                 @default(false) // renk bazli gorsel galerisi bu ozellik ekseninde gruplanir
  values    VariantAttributeValue[]
  createdAt DateTime                @default(now())
}

// Bir ozelligin alabilecegi degerler (S, M, L / Siyah, Beyaz ...)
model VariantAttributeValue {
  id           String                 @id @default(cuid())
  attributeId  String
  attribute    VariantAttribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String                 // "M", "Siyah"
  hexColor     String?                // sadece Renk gibi ozellikler icin opsiyonel, ornek "#111111"
  position     Int                    @default(0)
  variantLinks ProductVariantOption[]
  optionImages ProductOptionImage[]

  @@unique([attributeId, value])
}

// Renk (veya isColor=true olan baska bir ozellik) bazinda urun gorsel seti -
// bedenden bagimsiz, bir renge ait birden fazla fotograf tutar.
model ProductOptionImage {
  id        String                 @id @default(cuid())
  productId String
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  valueId   String
  value     VariantAttributeValue  @relation(fields: [valueId], references: [id], onDelete: Cascade)
  url       String
  alt       String                 @default("")
  position  Int                    @default(0)
  // Katalog kartinda o renk icin ilk gosterilecek fotograf - position'dan
  // bagimsiz, sadece bunu isaretler (bkz. lib/catalog.ts pickCoverImage).
  isCover   Boolean                @default(false)
  createdAt DateTime               @default(now())

  @@index([productId, valueId])
}

// Bir varyantin secili ozellik degerleri ile baglantisi (coka-cok)
model ProductVariantOption {
  id        String                @id @default(cuid())
  variantId String
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  valueId   String
  value     VariantAttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([variantId, valueId])
}

// Beden / renk gibi varyantlar, her biri kendi stok adedine sahip
model ProductVariant {
  id             String   @id @default(cuid())
  vegaId         Int      @unique @default(autoincrement())
  sku            String   @unique
  barcode        String?  // opsiyonel, SKU'dan ayri, kasa/etiket icin
  stock          Int      @default(0)
  priceCents     Int?     // opsiyonel - bos ise Product.priceCents kullanilir
  compareAtCents Int?     // opsiyonel - bos ise Product.compareAtCents kullanilir
  options        ProductVariantOption[]
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  stockAlerts    StockAlert[]
}

// Bir varyant stokta yokken "stok gelince haber ver" kaydi. Ayni kisi ayni
// varyant icin tekrar kayit olursa hata degil, mevcut kayit guncellenir
// (upsert) - bkz. @@unique.
model StockAlert {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email      String
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([variantId, email])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  status        String      @default("PENDING_PAYMENT")
  customerName  String
  customerEmail String
  customerPhone String
  // Giris yapmis musteriye opsiyonel baglanti - misafir siparişte null kalir
  // (Bollmark'ta hesap zorunlu degil, bkz. lib/customer-auth.ts).
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  shippingAddress String
  city          String
  district      String
  postalCode    String?
  note          String?
  subtotalCents Int
  discountCents Int         @default(0)
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  // Bundle indirimi - kupon/puan ile ayni sirada, ayri bir kalem (bkz. lib/bundles.ts)
  bundleDiscountCents Int   @default(0)
  // Sadakat puani kazanc/kullanim alanlari - bkz. lib/loyalty.ts
  pointsEarned         Int  @default(0)
  pointsRedeemed       Int  @default(0)
  loyaltyDiscountCents Int  @default(0)
  shippingCents Int         @default(0)
  totalCents    Int
  items         OrderItem[]
  shipment      Shipment?
  returnRequests ReturnRequest[]
  viewedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // Soft delete - hard delete yapilmiyor cunku OrderItem/Shipment cascade
  // silinir ve ReturnRequest/LoyaltyTransaction gibi ilişkili kayitlar
  // bozulur (bkz. SIPARIS_SILME_VE_GECMISI_PLANI.md). deletedAt dolu
  // siparişler normal liste/rapor sorgularindan (order-query.ts) hariç
  // tutulur, "Silinen Siparişler" sayfasinda geri yuklenebilir sekilde durur.
  deletedAt       DateTime?
  deletedByEmail  String?
  // Mesafeli Satis Sozlesmesi onay kaydi - checkout'ta zorunlu onay kutusunun
  // isaretlendigi an (KVKK/ispat yukumlulugu icin, bkz. HUKUKI_SAYFALAR_ICERIK_VE_PLAN.md).
  termsAcceptedAt DateTime?

  // iyzico Sanal POS alanlari (bkz. IYZICO_SANAL_POS_PLANI.md bolum 4) - hepsi
  // eklemeli: mevcut siparisler icin varsayilan "UNPAID" ve bos degerler.
  // paymentStatus: UNPAID | PAID | REVIEW | FAILED | PARTIALLY_REFUNDED | REFUNDED
  paymentStatus         String    @default("UNPAID")
  paymentProvider       String?
  paymentMode           String?
  paidAt                DateTime?
  paidCents             Int?
  installment           Int?
  paymentExpiresAt      DateTime?
  needsAttention        Boolean   @default(false)
  attentionNote         String?
  shippingPaymentTransactionId String?
  shippingPaidCents     Int?
  shippingRefundedCents Int       @default(0)
  paymentAttempts       PaymentAttempt[]
  paymentRefunds        PaymentRefund[]

  // Meta Conversions API (bkz. META_PIXEL_CAPI_PLANI.md, lib/meta/capi.ts):
  // siparis anindaki pazarlama rizasi varsa JSON {fbp, fbc, ua, test} - yoksa
  // null ve Purchase hic gonderilmez. IP SAKLANMAZ. metaPurchaseSentAt
  // Purchase'in siparis basina tek kez gitmesini saglar.
  metaCapiContext       String?
  metaPurchaseSentAt    DateTime?

  // Vega (Ticimax taklidi SiparisServis, bkz. VEGA_SIPARIS_AKTARIM_PLANI.md):
  // Ticimax siparis kimligini int bekliyor (Product.vegaId ile ayni gerekce);
  // Vega cift kaydi bu ID ile ayiriyor. vegaFetchedAt Vega'nin siparisi
  // aldigini SetSiparisDurum("Onaylandi") ile bildirdigi an - o ana kadar Vega
  // stok gonderiminde bu siparisin adetleri dusulur.
  vegaId                Int       @unique @default(autoincrement())
  vegaFetchedAt         DateTime?

  // Kalp Topla (KALP_TOPLA_PLANI.md 4.1)
  kalpDiscountCents Int @default(0)       // rapor ve özet için
  kalpTestAt        DateTime?             // Y12: test kuponuyla verilmiş sipariş; kampanya raporlarından hariç

  @@index([deletedAt])
  @@index([paymentStatus])
}

// Musteri hesabi - opsiyonel katman, misafir siparis akisi bundan bagimsiz
// calismaya devam eder (bkz. lib/customer-auth.ts). Admin girisinden
// (AdminUser/authOptions) tamamen ayri bir NextAuth ornegi kullanir.
model Customer {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  passwordHash  String
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())
  addresses     CustomerAddress[]
  orders        Order[]
  loyaltyLedger LoyaltyTransaction[]
  wishlistItems WishlistItem[]
  cart          CustomerCart?

  // Kalp Topla (KALP_TOPLA_PLANI.md 4.1)
  emailVerifiedAt       DateTime?
  referralCode          String?  @unique   // kişisel davet kodu (ilk ihtiyaçta üretilir)
  referredById          String?            // davet eden üye (bir kez yazılır)
  inviteTargetProductId String?            // genel davet linkinde +2'nin hedef ürünü
  marketingEmailAt      DateTime?          // dolu = e-posta onayı var (her değişiklik MarketingConsentLog'a da)
  marketingWhatsappAt   DateTime?          // Faz 2 için toplanır, ilk sürümde ileti yok
  pushPromptDismissedAt DateTime?          // push sorusu reddedildi: 7 gün sorulmaz
}

// Giris yapmis musterinin cihazlar arasi sepeti (bkz. lib/cart.tsx, api/sepet).
// Yalniz productId/variantId/quantity saklanir - fiyat, isim ve gorsel HICBIR
// zaman kopyalanmaz, her okumada guncel urun kaydindan uretilir.
model CustomerCart {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  linesJson  String   @default("[]")
  couponCode String?
  kalpSelectionJson String @default("{}") // Kalp Topla: { manual: variantId[], removed: variantId[] }
  updatedAt  DateTime @updatedAt
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String // "Ev", "Is" vb.
  name       String
  phone      String
  address    String
  city       String
  district   String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Pozitif = kazanc (siparis DELIVERED oldugunda), negatif = kullanim
// (checkout'ta indirime cevrildiginde) veya admin elle duzeltmesi.
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int
  reason     String // "SIPARIS_KAZANC" | "SIPARIS_KULLANIM" | "ADMIN_DUZELTME"
  orderId    String?
  createdAt  DateTime @default(now())
}

// Iade / degisim talebi. Bollmark'ta musteri hesabi olmadigi icin (siparis
// no + e-posta ile takip) talep de ayni dogrulamayla acilir - bkz.
// api/iade-talebi/route.ts. itemsJson, AbandonedCart.linesJson ile ayni
// "anlik goruntu" deseni: [{orderItemId, quantity}].
model ReturnRequest {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  type         String   // "IADE" | "DEGISIM"
  reason       String
  itemsJson    String
  status       String   @default("TALEP_EDILDI")
  customerNote String?
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Kalp Topla (KALP_TOPLA_PLANI.md 4.1, T6/Y6)
  exchangeVariantId      String?   // değişim ürünü/varyantı
  exchangeUnitCents      Int?      // değişim ürününün hesaplanan birim fiyatı
  exchangeDiffCents      Int?      // + müşteriden alınacak, - müşteriye ödenecek
  exchangeDiffSettledAt  DateTime? // admin "tahsil edildi / iade edildi" işaretledi
  exchangeDiffSettledBy  String?   // işaretleyen admin e-postası
  kalpHandledAt          DateTime? // kupon geri yükleme/taşıma bir kez yapılsın diye
}

// Indirim kodu / kampanya (v1: yuzde, sabit tutar, ucretsiz kargo). Kod hep
// buyuk harfe normalize edilip saklanir. Indirim tutari ASLA istemciden
// gelen degerle degil, her zaman sunucuda (bkz. lib/coupons.ts) yeniden
// hesaplanir.
model Coupon {
  id            String    @id @default(cuid())
  // Kod girilen kampanyalarda tekil kod, kodsuz (otomatik) kampanyalarda null
  // - Postgres nullable unique alanda birden fazla NULL'a izin verir, cakisma
  // olmaz. Kodsuz kampanyalar musteri hicbir sey yazmadan sepete/urune
  // otomatik uygulanir (bkz. lib/coupons.ts resolveBestDiscount).
  code          String?   @unique
  // Kodsuz kampanyalarda listede ve site tarafinda gosterilecek gorunen ad
  // (orn. "Ayakkabilarda %20 Indirim"). Kod girilen kampanyalarda opsiyonel.
  name          String?
  type          String              // "PERCENT" | "FIXED" | "FREE_SHIPPING"
  value         Int       @default(0) // PERCENT: 1-100, FIXED: kurus, FREE_SHIPPING: kullanilmaz (0)
  minOrderCents Int       @default(0)
  usageLimit    Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  // Kisitlama - herhangi biri doluysa indirim sadece kategorisi/markasi/
  // cinsiyeti bu listelerden birine uyan sepet satirlarina uygulanir (bkz.
  // lib/coupons.ts) - alan icinde OR, alanlar arasi AND. Hepsi bos ise
  // kisitlama yok (tum sepet).
  categoryIds   String[]  @default([])
  brandIds      String[]  @default([])
  genders       String[]  @default([])
  // false iken bu kampanya, Product.compareAtCents > priceCents olan (zaten
  // elle indirimli) urunlere/satirlara dokunmaz - bkz. lib/coupons.ts.
  includeManuallyDiscountedProducts Boolean @default(false)
  orders        Order[]
  createdAt     DateTime  @default(now())
}

// Terk edilmis sepet - checkout formunda e-posta girilip (onBlur) siparis
// tamamlanmadan birakildiginda yakalanir. Ayni e-posta icin acik
// (recoveredAt=null) kayit varsa guncellenir, yoksa yeni olusturulur.
// Siparis basariyla tamamlaninca ayni e-postanin acik kayitlari
// recoveredAt ile isaretlenir - artik hatirlatma gonderilmez.
model AbandonedCart {
  id          String    @id @default(cuid())
  email       String
  linesJson   String // CartLine[] JSON anlik goruntusu (urun adi, beden, renk, adet, fiyat)
  totalCents  Int
  recoveredAt DateTime? // ayni e-postayla siparis tamamlaninca isaretlenir
  remindedAt  DateTime? // hatirlatma e-postasi gonderilince isaretlenir
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  quantity   Int
  unitPriceCents Int
  totalCents Int
  // iyzico kalem bazli iade icin (bkz. IYZICO_SANAL_POS_PLANI.md bolum 4)
  paymentTransactionId String?
  paidCents            Int?
  refundedCents        Int     @default(0)
  // Kalp Topla (KALP_TOPLA_PLANI.md 4.1)
  // Tekil degil: geri donen kupon yeni sipariste de kullanilir, eski satirdaki kayit kalir.
  // Cift kullanimi kuponun durumu (RESERVED/USED) engeller.
  kalpCouponId          String?           // bu satıra uygulanan Kalp Topla kuponu
  kalpOriginalUnitCents Int?              // kuponsuz olsaydı ödenecek birim fiyat
  kalpRestoredAt        DateTime?         // kupon bu satırdan bir kez geri yüklendi

  @@index([kalpCouponId])
}

// Magaza geneli ayarlar - tek satirlik "singleton" kayit (id her zaman "singleton")
model StoreSettings {
  id                   String   @id @default("singleton")
  storeName            String   @default("Bollmark")
  contactEmail         String   @default("")
  contactPhone         String   @default("")
  defaultShippingCents Int      @default(0)
  // Terk edilmis sepet hatirlatma ayarlari - cron gunde 1 kez calisir (bkz.
  // vercel.json, saat 08:00), bu yuzden "saat" bir gecikme esigi, kesin
  // gonderim zamani degil (bkz. api/cron/sepet-hatirlatma/route.ts).
  abandonedCartReminderEnabled Boolean @default(true)
  abandonedCartReminderHours   Int     @default(1)
  updatedAt            DateTime @updatedAt
}

// Anasayfa Instagram galerisinin otomatik beslemesi (bkz. lib/instagram.ts,
// api/cron/instagram). Singleton satir (StoreSettings ile ayni desen). Token
// "Instagram API with Instagram Login" uzun omurlu token'i (60 gun); acik
// metin olarak DEGIL, lib/payment/crypto.ts ile sifreli tutulur.
model InstagramIntegration {
  id               String    @id @default("singleton")
  tokenEncrypted   String    @default("")
  username         String    @default("")
  tokenExpiresAt   DateTime?
  tokenRefreshedAt DateTime?
  lastFetchAt      DateTime? // son BASARILI cekim
  lastError        String    @default("")
  // Son basarili cekimin kareleri: [{ id, imageUrl (R2), permalink, alt }]
  postsJson        String    @default("[]")
  // Galerinin profil basligi: { username, name, pictureUrl (R2), pictureSource, followers, mediaCount }
  profileJson      String    @default("{}")
  // Admin Ayarlar'dan anasayfa galerisi gizlenebilir (cekim yine surer).
  showOnHome       Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
}

// Vega "E-Ticaret" entegrasyonu icin ayri, admin panel personel
// hesaplarindan bagimsiz tek bir kullanici - Vega programindaki "E-Mail"/
// "Parola" alanlarina bu bilgiler girilir (bkz.
// VEGA_PANELAPI_BULGULARI_VE_PLAN.md). Singleton satir (StoreSettings ile
// ayni desen).
model VegaIntegration {
  id           String   @id @default("singleton")
  email        String   @default("")
  passwordHash String   @default("")
  sessions     VegaSession[]
  // Ticimax taklidi SOAP entegrasyonu (Servis/UrunServis.svc vb.) icin ayri
  // bir kimlik dogrulama alani - Ticimax'in gercek protokolunde tek bir
  // "UyeKodu" (duz metin, API anahtari gibi calisan bir paylasilan sir)
  // var, email+parola cifti yok. Panelden gosterilebilmesi icin (Vega'ya
  // aynen kopyalanacak) bilerek hash'lenmeden saklaniyor.
  ticimaxUyeKodu String @default("")
  updatedAt    DateTime @updatedAt
}

// Vega'nin Account/Token'dan aldigi Bearer token'lar burada saklanir. Tek
// bir "aktif token" alani (VegaIntegration uzerinde) YETERSIZ kaldi -
// Claude'un dogrulama icin attigi test giris istekleri, Vega'nin kendi
// aldigi token'i sessizce geciriyordu (her yeni giris bir oncekini
// gecersiz kiliyordu), bu da canli testte gercek bir hata gibi gorunen
// yanlis "gecersiz token" hatalarina yol acti. Artik her giris kendi
// bagimsiz satirini aliyor, birbirini etkilemiyor.
model VegaSession {
  id                 String          @id @default(cuid())
  token              String          @unique
  vegaIntegrationId  String
  vegaIntegration    VegaIntegration @relation(fields: [vegaIntegrationId], references: [id], onDelete: Cascade)
  expiresAt          DateTime
  createdAt          DateTime        @default(now())
}

// Kritik islemlerin (siparis/iade durum degisikligi, personel yonetimi,
// sadakat puani duzeltmesi) denetim kaydi - v1'de sadece gurultu
// yaratmayacak kritik islemler loglanir (bkz. lib/audit-log.ts).
model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorRole  String
  action     String // "ORDER_STATUS_CHANGED", "RETURN_STATUS_CHANGED", "PERSONEL_CREATED", "PERSONEL_UPDATED", "LOYALTY_ADJUSTED" ...
  targetType String // "Order" | "ReturnRequest" | "AdminUser" | "Customer" ...
  targetId   String
  detail     String? // kisa metin, orn. "PENDING_PAYMENT -> PAID"
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// Hakkimizda, Kargo Bilgisi, Iade Kosullari, Gizlilik Politikasi, Mesafeli
// Satis Sozlesmesi gibi sabit yasal/bilgi sayfalari - icerik admin panelden
// duzenlenir, site tarafinda /sayfa/[slug] altinda gosterilir.
model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique // "hakkimizda" | "kargo-bilgisi" | "iade-kosullari" | "gizlilik-politikasi" | "mesafeli-satis-sozlesmesi"
  title     String
  content   String // duz metin, satir sonlari whitespace-pre-line ile render edilir
  updatedAt DateTime @updatedAt
}

// Cerez bandindaki her rıza seciminin ispat kaydi (KVKK, bkz.
// CEREZ_BANDI_PLANI.md). visitorId bm_consent cerezinde tutulan rastgele
// anonim kimliktir. Ham IP saklanmaz. userId giris yapmis musterinin id'si -
// iliski bilerek kurulmadi, musteri silinse de rıza kaydi kalir.
model ConsentLog {
  id        String   @id @default(cuid())
  visitorId String
  analytics Boolean
  marketing Boolean
  version   String
  userId    String?
  createdAt DateTime @default(now())

  @@index([visitorId])
}

// /iletisim (Bize Ulasin) formundan gelen mesajlar - admin panelde
// /admin/mesajlar altinda listelenir. ipHash, hiz siniri (10 dk'da en fazla 3
// gonderim) icin ham IP yerine tuzlanmis SHA-256 ozeti olarak tutulur
// (bkz. api/iletisim/route.ts).
model ContactMessage {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String? // artik formdan alinmiyor (geri donus e-posta ile), eski sutun
  contactPrefs String[] // artik formdan alinmiyor, eski sutun
  message      String
  status       String   @default("YENI") // "YENI" | "OKUNDU" | "YANITLANDI"
  ipHash       String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

model Shipment {
  id           String         @id @default(cuid())
  orderId      String         @unique
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier      String         @default("")
  trackingCode String?
  status       String         @default("HAZIRLANIYOR")
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// --- iyzico Sanal POS (bkz. IYZICO_SANAL_POS_PLANI.md bolum 4) ---

// Tek satirlik "singleton" kayit. Anahtarlar AES-256-GCM ile sifrelenmis
// (iv+tag+ciphertext, base64) saklanir; sifreleme anahtari PAYMENT_ENCRYPTION_KEY
// env'inde durur, veritabaninda degil (lib/payment/crypto.ts).
model PaymentSettings {
  id                  String    @id @default("singleton")
  provider            String    @default("IYZICO")
  isEnabled           Boolean   @default(false)
  // SANDBOX | LIVE - gecerli mod lib/payment/iyzico/mode.ts'teki resolveMode()
  // ile belirlenir (LIVE yalnizca production ortaminda gecerli).
  mode                String    @default("SANDBOX")
  maxInstallment      Int       @default(1)
  orderExpiryMinutes  Int       @default(60)
  sandboxApiKeyEnc    String?
  sandboxSecretKeyEnc String?
  liveApiKeyEnc       String?
  liveSecretKeyEnc    String?
  // Panelde "son 4 hane" gostermek icin (anahtarin kendisi degil)
  sandboxKeyLast4     String?
  liveKeyLast4        String?
  lastTestAt          DateTime?
  lastTestOk          Boolean?
  lastTestMode        String?
  lastTestMessage     String?
  updatedAt           DateTime  @updatedAt
}

// Her odeme denemesi icin bir kayit
model PaymentAttempt {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mode            String
  token           String    @unique
  conversationId  String
  // INITIATED | SUCCESS | FAILED | REVIEW | EXPIRED
  status          String    @default("INITIATED")
  errorCode       String?
  errorMessage    String?
  paymentId       String?
  paidCents       Int?
  installment     Int?
  fraudStatus     Int?
  cardAssociation String?
  cardType        String?
  cardFamily      String?
  binNumber       String?
  lastFourDigits  String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  refunds         PaymentRefund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentRefund {
  id                   String         @id @default(cuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptId            String
  attempt              PaymentAttempt @relation(fields: [attemptId], references: [id])
  orderItemId          String?
  isShipping           Boolean        @default(false)
  paymentTransactionId String
  amountCents          Int
  // REFUND | CANCEL
  kind                 String
  // BUYER_REQUEST | DOUBLE_PAYMENT | FRAUD | OTHER
  reason               String
  description          String?
  // PENDING | SUCCESS | FAILED
  status               String         @default("PENDING")
  errorCode            String?
  errorMessage         String?
  hostReference        String?
  restock              Boolean        @default(false)
  createdByEmail       String
  createdAt            DateTime       @default(now())
  completedAt          DateTime?

  @@index([orderId])
}

// Yalnizca gozlem amacli odeme gunlugu - kart, anahtar, secret ve token ASLA yazilmaz.
model PaymentLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  // INIT | CALLBACK | RETRIEVE | WEBHOOK | REFUND | CANCEL | TEST | RECONCILE | EXPIRE | SETTINGS
  kind       String
  orderId    String?
  attemptId  String?
  ok         Boolean
  httpStatus Int?
  errorCode  String?
  summary    String

  @@index([createdAt])
  @@index([orderId])
}

// ============================================================================
// Kalp Topla kampanyası (KALP_TOPLA_PLANI.md bölüm 4.2). Tablolar birbirine
// plan gereği yalnız id alanlarıyla bağlı (FK yok). Kısmi unique indeks
// KalpHeart'ta, Prisma partialIndexes önizleme özelliğiyle tanımlı.
// ============================================================================

model KalpToplaSettings {
  id                 String   @id @default("singleton")
  mode               String   @default("OFF")  // OFF | HIDDEN | LIVE (Y10)
  testerCustomerIds  String[] @default([])     // HIDDEN modunda kampanyayı görenler
  threshold          Int      @default(10)     // yalnız YENİ turlara uygulanır (T16)
  testThreshold      Int      @default(2)      // Y12: yalnız HIDDEN modda açılan (test) turlara uygulanır
  discountPercent    Int      @default(50)
  couponHours        Int      @default(48)
  heartQuota         Int      @default(3)
  inviteBonus        Int      @default(2)
  refundExtraHours   Int      @default(24)
  // Y2 kötüye kullanım eşikleri (yalnız davet bonusunu etkiler, üyeliği/kalbi/kuponu engellemez)
  sameDeviceMaxAccounts Int   @default(1)      // aynı cihazdan bu sayıyı aşan hesapların bonusu "incelemede" (1 = ikinci ve sonrası)
  sameIpWindowHours  Int      @default(24)
  sameIpMinAccounts  Int      @default(3)      // pencere içinde aynı IP özetinden bu kadar ya da fazla yeni hesap: yalnız "aynı IP" işareti
  updatedAt          DateTime @updatedAt
}

// Y4: npm paketine ek, admin'in elle engellediği alan adları.
model BlockedEmailDomain {
  id             String   @id @default(cuid())
  domain         String   @unique   // küçük harf, ör. "ornekmail.com"
  createdByEmail String
  createdAt      DateTime @default(now())
}

// Y2/Y3: kötüye kullanım kontrolü için cihaz ve IP görülmeleri. 90 gün sonra silinir.
// Kayıt ve girişte yazılır (davet edenin cihazı da eşleşebilsin diye).
model CustomerDevice {
  id         String   @id @default(cuid())
  customerId String
  deviceId   String             // bm_cihaz çerezindeki rastgele kimlik
  ipHash     String?            // IP'nin tuzlanmış SHA-256 özeti (ham IP tutulmaz)
  event      String             // SIGNUP | LOGIN
  createdAt  DateTime @default(now())
  @@index([deviceId, createdAt])
  @@index([ipHash, event, createdAt])
  @@index([customerId])
  @@index([createdAt])          // 90 gün temizliği
}

model KalpBar {
  productId      String   @id
  currentRoundId String   @unique
  points         Int      @default(0)   // açık turdaki ACTIVE kalp + APPLIED bonus toplamı
  closedRounds   Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model KalpRound {
  id        String    @id @default(cuid())
  productId String
  roundNo   Int
  threshold Int                          // tur açıldığı andaki eşik (T16); test turunda testThreshold (Y12)
  status    String    @default("OPEN")   // OPEN | CLOSED
  isTest    Boolean   @default(false)    // HIDDEN modunda açılan test turu (Y12)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  @@unique([productId, roundNo])
}

model KalpHeart {
  id         String    @id @default(cuid())
  customerId String
  productId  String
  roundId    String
  // PENDING (doğrulanmamış, hak kullanır) | ACTIVE | WITHDRAWN | WON
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())
  endedAt    DateTime?
  @@index([customerId, status])
  @@index([roundId, status])
  @@index([productId, createdAt])
  // Bir üyenin aynı üründe tek açık (PENDING/ACTIVE) kalbi olur. Koşul, Postgres'in
  // sakladığı biçimle yazıldı; "status IN (...)" yazılırsa db push her seferinde fark görür.
  @@unique([customerId, productId], map: "KalpHeart_open_unique", where: raw("status = ANY (ARRAY['PENDING'::text, 'ACTIVE'::text])"))
}

model KalpInvite {
  id              String    @id @default(cuid())
  inviterId       String
  inviteeId       String    @unique      // bir kişi yalnız bir kez davet edilmiş sayılır
  productId       String?                // linkin bağlı olduğu ürün
  // PENDING_VERIFICATION | UNDER_REVIEW | CREDITED (bonus kredisi oluştu, bkz. KalpBonusCredit)
  // | CANCELLED (admin)
  status          String    @default("PENDING_VERIFICATION")
  reviewReasons   String[]  @default([]) // incelemeye düşüren nedenler: SAME_DEVICE | SAME_DEVICE_AS_INVITER
  sameIpFlagAt    DateTime?              // Y2/Y13: yalnız işaret, durumu ve bonusu etkilemez
  isTest          Boolean   @default(false) // HIDDEN modda oluşan test daveti (Y12)
  reviewedByEmail String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?
  @@index([inviterId, status])
  @@index([status, createdAt])
}

// Bonus puanlarının nerede durduğunu tutar. Bir davet tek kredi ile başlar.
// Bonus bir barı eşiğin üstüne taşırsa kredi bölünür: eşiğe kadar olan kısım
// ROUND_CLOSED, artan kısım yeni bir WAITING kredisi olur, 30 gün baştan (Y11).
// Benzersiz indeksler (kredi iki kez olusamaz/bolunemez) elle uygulandi:
// prisma/manual-sql/2026-10-30-kalp-bonus-credit-indeksleri.sql. Ikisi de asagida
// tanimli (kismi olan: KalpBonusCredit_root_unique), semayla DB ayni kalir.
model KalpBonusCredit {
  id         String    @id @default(cuid())
  inviteId   String
  customerId String               // bonusun sahibi (davet eden)
  points     Int                  // bu kredideki puan
  // WAITING (bekleyen bonus) | APPLIED (bir bardaki kalbe bağlı) | ROUND_CLOSED (işini gördü)
  // | VOID_WITHDRAWN (bağlı kalp geri çekildi) | EXPIRED (30 gün doldu) | CANCELLED (admin)
  status     String    @default("WAITING")
  heartId    String?              // APPLIED iken bağlı kalp
  roundId    String?
  splitFromId String?  @unique(map: "KalpBonusCredit_splitFromId_key") // Y11: artan kısımdan doğduysa ana kredi (bir kredi en çok bir kez bölünür)
  expiresAt  DateTime?            // WAITING iken bitiş (30 gün, kampanya kapalıyken de işler; bölünmede baştan)
  isTest     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  @@index([customerId, status])
  @@index([heartId, status])
  @@index([status, expiresAt])
  @@unique([inviteId], map: "KalpBonusCredit_root_unique", where: raw("(\"splitFromId\" IS NULL)")) // davet başına tek kök kredi
}

model KalpCoupon {
  id              String    @id @default(cuid())
  code            String    @unique      // ör. "KALP-7KD2QX"
  customerId      String
  roundId         String
  discountPercent Int
  expiresAt       DateTime
  status          String    @default("AVAILABLE") // AVAILABLE | RESERVED | USED | TEST_CANCELLED (Y15) | CANCELLED (admin iptali, Faz 10)
  usedAt          DateTime?
  restoredAt      DateTime?
  expiringEmailAt DateTime?              // "son 6 saat" e-postası/olayı üretildi (kupon başına 1, Y1)
  isTest          Boolean   @default(false) // test turundan kazanılan kupon (Y12)
  createdAt       DateTime  @default(now())
  @@index([customerId, status, expiresAt])
}

model Notification {
  id          String    @id @default(cuid())
  customerId  String
  type        String    // COUPON_WON | BAR_NEAR | INVITE_JOINED | COUPON_EXPIRING | BONUS_EXPIRED | COUPON_RESTORED
  eventKey    String    @unique
  title       String
  body        String
  link        String?
  payloadJson String    @default("{}")
  readAt      DateTime?
  // PENDING | SENT | SKIPPED_DAILY_LIMIT | SKIPPED_NO_CONSENT | NOT_APPLICABLE | FAILED
  emailStatus String    @default("PENDING")
  pushStatus  String    @default("PENDING")
  createdAt   DateTime  @default(now())
  @@index([customerId, createdAt])
  @@index([emailStatus, createdAt])
}

// Y1: BAR_NEAR ve INVITE_JOINED e-postaları için kişi başı günde 1 (İstanbul günü).
model ReminderEmailDay {
  id             String   @id @default(cuid())
  customerId     String
  dayKey         String   // "2026-11-03" (istanbulDateKey)
  notificationId String   // o günün e-postasını alan olay
  createdAt      DateTime @default(now())
  @@unique([customerId, dayKey])
}

model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
}

model MarketingConsentLog {
  id          String    @id @default(cuid())
  customerId  String
  email       String
  channel     String    // EMAIL | PUSH | WHATSAPP
  granted     Boolean
  source      String    // KAYIT_FORMU | HESAP_AYARLARI | KALP_PENCERESI | ABONELIK_IPTAL_LINKI
  ip          String?   // Y3: ham IP; onay geri çekildikten 3 yıl sonra null'lanır
  ipPurgedAt  DateTime?
  textVersion String
  createdAt   DateTime  @default(now())
  @@index([customerId, channel, createdAt])
  @@index([createdAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}
